    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3"
  }
}
