{
  "name": "ci-selftest-node",
  "version": "0.1.0",
  "private": true,
  "description": "koorikla/ci selftest fixture: Fastify API in TypeScript (node.yaml)",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
